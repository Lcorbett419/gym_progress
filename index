/* ---------- component ---------- */

export default function GymTracker() {
  const [loading, setLoading] = useState(true);
  const [names, setNames] = useState({ a: "Me", b: "Adam" });
  const [logs, setLogs] = useState({ a: [], b: [] });
  const [custom, setCustom] = useState({});
  const [who, setWho] = useState("a");
  const [tab, setTab] = useState("log");
  const [toast, setToast] = useState("");
  const [renaming, setRenaming] = useState(false);
  const [draftNames, setDraftNames] = useState({ a: "", b: "" });

  // log form
  const [group, setGroup] = useState("Chest");
  const [exercise, setExercise] = useState("Bench Press");
  const [weight, setWeight] = useState("");
  const [reps, setReps] = useState("");
  const [date, setDate] = useState(todayStr());
  const [saving, setSaving] = useState(false);
  const [newEx, setNewEx] = useState("");
  const [addingEx, setAddingEx] = useState(false);

  // progress
  const [pGroup, setPGroup] = useState("Chest");
  const [pEx, setPEx] = useState("Bench Press");
  const [metric, setMetric] = useState("e1rm");

  // history
  const [hFilter, setHFilter] = useState("all");
  const [confirmDel, setConfirmDel] = useState(null);

  const exercisesFor = useCallback(
    (g) => [...DEFAULT_EXERCISES[g], ...(custom[g] || [])],
    [custom]
  );

  const showToast = (msg) => {
    setToast(msg);
    setTimeout(() => setToast(""), 2200);
  };

  /* ----- load ----- */
  const loadAll = useCallback(async () => {
    const [n, la, lb, c, me] = await Promise.all([
      store.get("names", true),
      store.get("log:a", true),
      store.get("log:b", true),
      store.get("custom-exercises", true),
      store.get("whoami", false),
    ]);
    if (n) setNames(n);
    setLogs({ a: la || [], b: lb || [] });
    if (c) setCustom(c);
    return me;
  }, []);

  useEffect(() => {
    (async () => {
      const me = await loadAll();
      if (me === "a" || me === "b") setWho(me);
      setLoading(false);
    })();
  }, [loadAll]);

  const pickWho = (k) => {
    setWho(k);
    store.set("whoami", k, false);
  };

  const refresh = async () => {
    await loadAll();
    showToast("Refreshed");
  };

  /* ----- last set hint + prefill ----- */
  const lastSet = useMemo(() => {
    const list = logs[who].filter((e) => e.exercise === exercise);
    if (!list.length) return null;
    return [...list].sort((x, y) =>
      x.date === y.date ? x.id.localeCompare(y.id) : x.date.localeCompare(y.date)
    )[list.length - 1];
  }, [logs, who, exercise]);

  useEffect(() => {
    if (lastSet) {
      setWeight(String(lastSet.weight));
      setReps(String(lastSet.reps));
    } else {
      setWeight("");
      setReps("");
    }
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [who, exercise, loading]);

  /* ----- actions ----- */
  const bump = (setter, current, delta, min = 0) => {
    const n = parseFloat(current);
    const base = isNaN(n) ? 0 : n;
    setter(String(Math.max(min, round1(base + delta))));
  };

  const saveSet = async () => {
    const w = parseFloat(weight);
    const r = parseInt(reps, 10);
    if (isNaN(w) || w < 0) return showToast("Enter a weight in kg");
    if (isNaN(r) || r < 1) return showToast("Enter at least 1 rep");
    setSaving(true);
    const entry = { id: newId(), date, group, exercise, weight: w, reps: r };
    const latest = (await store.get(`log:${who}`, true)) || [];
    const next = [...latest, entry];
    const ok = await store.set(`log:${who}`, next, true);
    setSaving(false);
    if (ok) {
      setLogs((l) => ({ ...l, [who]: next }));
      showToast(`Saved: ${exercise} ${w}kg x ${r}`);
    } else {
      showToast("Couldn't save. Try again.");
    }
  };

  const deleteEntry = async (slot, id) => {
    const latest = (await store.get(`log:${slot}`, true)) || [];
    const next = latest.filter((e) => e.id !== id);
    const ok = await store.set(`log:${slot}`, next, true);
    if (ok) {
      setLogs((l) => ({ ...l, [slot]: next }));
      showToast("Set deleted");
    } else showToast("Couldn't delete. Try again.");
    setConfirmDel(null);
  };

  const addExercise = async () => {
    const name = newEx.trim();
    if (!name) return;
    if (exercisesFor(group).some((e) => e.toLowerCase() === name.toLowerCase()))
      return showToast("That exercise already exists");
    const latest = (await store.get("custom-exercises", true)) || {};
    const next = { ...latest, [group]: [...(latest[group] || []), name] };
    const ok = await store.set("custom-exercises", next, true);
    if (ok) {
      setCustom(next);
      setExercise(name);
      setNewEx("");
      setAddingEx(false);
      showToast(`Added ${name}`);
    } else showToast("Couldn't add exercise. Try again.");
  };

  const saveNames = async () => {
    const next = {
      a: draftNames.a.trim() || "Me",
      b: draftNames.b.trim() || "Adam",
    };
    const ok = await store.set("names", next, true);
    if (ok) {
      setNames(next);
      setRenaming(false);
      showToast("Names updated");
    } else showToast("Couldn't save names");
  };

  /* ----- progress data ----- */
  const chartData = useMemo(() => {
    const byDate = {};
    SLOTS.forEach((k) => {
      logs[k]
        .filter((e) => e.exercise === pEx)
        .forEach((e) => {
          const v =
            metric === "e1rm"
              ? e1rm(e.weight, e.reps)
              : metric === "top"
              ? e.weight
              : e.weight * e.reps;
          const row = (byDate[e.date] = byDate[e.date] || { date: e.date });
          row[k] =
            metric === "vol" ? (row[k] || 0) + v : Math.max(row[k] || 0, v);
        });
    });
    return Object.values(byDate)
      .sort((x, y) => x.date.localeCompare(y.date))
      .map((r) => ({
        ...r,
        label: fmtDate(r.date),
        a: r.a != null ? round1(r.a) : undefined,
        b: r.b != null ? round1(r.b) : undefined,
      }));
  }, [logs, pEx, metric]);

  const statsFor = useCallback(
    (k) => {
      const list = logs[k]
        .filter((e) => e.exercise === pEx)
        .sort((x, y) => x.date.localeCompare(y.date));
      if (!list.length) return null;
      const top = list.reduce((best, e) =>
        e.weight > best.weight ||
        (e.weight === best.weight && e.reps > best.reps)
          ? e
          : best
      );
      const best1 = Math.max(...list.map((e) => e5(e)));
      const firstDay = list[0].date;
      const first1 = Math.max(
        ...list.filter((e) => e.date === firstDay).map((e) => e5(e))
      );
      return {
        top,
        best1: round1(best1),
        change: round1(best1 - first1),
        sets: list.length,
        days: new Set(list.map((e) => e.date)).size,
      };
    },
    [logs, pEx]
  );
  function e5(e) {
    return e1rm(e.weight, e.reps);
  }

  const overall = useMemo(() => {
    const o = {};
    SLOTS.forEach((k) => {
      o[k] = {
        sets: logs[k].length,
        days: new Set(logs[k].map((e) => e.date)).size,
        volume: Math.round(logs[k].reduce((s, e) => s + e.weight * e.reps, 0)),
      };
    });
    return o;
  }, [logs]);

  /* ----- history ----- */
  const historyGroups = useMemo(() => {
    const all = [];
    SLOTS.forEach((k) => {
      if (hFilter === "all" || hFilter === k)
        logs[k].forEach((e) => all.push({ ...e, slot: k }));
    });
    all.sort((x, y) =>
      x.date === y.date ? y.id.localeCompare(x.id) : y.date.localeCompare(x.date)
    );
    const groups = [];
    all.forEach((e) => {
      const last = groups[groups.length - 1];
      if (last && last.date === e.date) last.items.push(e);
      else groups.push({ date: e.date, items: [e] });
    });
    return groups;
  }, [logs, hFilter]);

  /* ---------- render ---------- */

  if (loading) {
    return (
      <div className="gl">
        <style>{css}</style>
        <div className="gl-wrap gl-empty">Loading your lifts...</div>
      </div>
    );
  }

  const me = who;
  const other = who === "a" ? "b" : "a";

  return (
    <div className="gl">
      <style>{css}</style>
      <div className="gl-wrap">
        {/* header */}
        <div className="gl-head">
          <div>
            <h1 className="gl-title gl-cond">Gym log</h1>
            <div className="gl-sub">
              Logging as <b style={{ color: COLORS[me] }}>{names[me]}</b>
            </div>
          </div>
          <div className="gl-plates" role="group" aria-label="Who is lifting">
            {SLOTS.map((k) => (
              <button
                key={k}
                className="gl-plate-btn"
                style={{ "--c": COLORS[k] }}
                aria-pressed={who === k}
                onClick={() => pickWho(k)}
                aria-label={`Log as ${names[k]}`}
              >
                <span className="gl-plate">
                  {names[k].charAt(0).toUpperCase()}
                </span>
                <span className="gl-plate-name">{names[k]}</span>
              </button>
            ))}
          </div>
        </div>

        {/* tabs */}
        <div className="gl-tabs" role="tablist">
          {[
            ["log", "Log a set"],
            ["progress", "Progress"],
            ["history", "History"],
          ].map(([id, label]) => (
            <button
              key={id}
              role="tab"
              aria-selected={tab === id}
              className="gl-tab"
              onClick={() => setTab(id)}
            >
              {label}
            </button>
          ))}
          <div style={{ flex: 1 }} />
          <button
            className="gl-icon"
            onClick={refresh}
            aria-label="Refresh data"
            title="Refresh (pull in your mate's latest sets)"
          >
            <RefreshCw size={18} />
          </button>
        </div>

        {/* ===== LOG TAB ===== */}
        {tab === "log" && (
          <div>
            <div className="gl-card">
              <span className="gl-label">Muscle group</span>
              <div className="gl-groups">
                {GROUPS.map((g) => (
                  <button
                    key={g}
                    className="gl-chip"
                    aria-pressed={group === g}
                    onClick={() => {
                      setGroup(g);
                      setExercise(exercisesFor(g)[0]);
                      setAddingEx(false);
                    }}
                  >
                    {g}
                  </button>
                ))}
              </div>

              <span className="gl-label" style={{ marginTop: 16 }}>
                Exercise
              </span>
              <div className="gl-chips">
                {exercisesFor(group).map((ex) => (
                  <button
                    key={ex}
                    className="gl-chip ex"
                    aria-pressed={exercise === ex}
                    onClick={() => setExercise(ex)}
                  >
                    {ex}
                  </button>
                ))}
                {!addingEx && (
                  <button
                    className="gl-chip ex"
                    style={{ borderStyle: "dashed", color: "var(--muted)" }}
                    onClick={() => setAddingEx(true)}
                  >
                    + Add exercise
                  </button>
                )}
              </div>
              {addingEx && (
                <div style={{ display: "flex", gap: 8, marginTop: 10 }}>
                  <input
                    className="gl-input"
                    placeholder={`New ${group.toLowerCase()} exercise`}
                    value={newEx}
                    onChange={(e) => setNewEx(e.target.value)}
                    onKeyDown={(e) => e.key === "Enter" && addExercise()}
                    autoFocus
                  />
                  <button
                    className="gl-btn ghost"
                    onClick={addExercise}
                    style={{ flex: "none" }}
                  >
                    Add
                  </button>
                  <button
                    className="gl-icon"
                    aria-label="Cancel"
                    onClick={() => {
                      setAddingEx(false);
                      setNewEx("");
                    }}
                  >
                    <X size={18} />
                  </button>
                </div>
              )}
            </div>

            <div className="gl-card">
              <div className="gl-row">
                <div>
                  <label className="gl-label" htmlFor="gl-w">
                    Weight (kg)
                  </label>
                  <div className="gl-stepper">
                    <button
                      aria-label="Decrease weight"
                      onClick={() => bump(setWeight, weight, -2.5)}
                    >
                      <Minus size={18} />
                    </button>
                    <input
                      id="gl-w"
                      inputMode="decimal"
                      value={weight}
                      placeholder="0"
                      onChange={(e) =>
                        setWeight(e.target.value.replace(/[^0-9.]/g, ""))
                      }
                    />
                    <button
                      aria-label="Increase weight"
                      onClick={() => bump(setWeight, weight, 2.5)}
                    >
                      <Plus size={18} />
                    </button>
                  </div>
                </div>
                <div>
                  <label className="gl-label" htmlFor="gl-r">
                    Reps
                  </label>
                  <div className="gl-stepper">
                    <button
                      aria-label="Decrease reps"
                      onClick={() => bump(setReps, reps, -1)}
                    >
                      <Minus size={18} />
                    </button>
                    <input
                      id="gl-r"
                      inputMode="numeric"
                      value={reps}
                      placeholder="0"
                      onChange={(e) =>
                        setReps(e.target.value.replace(/[^0-9]/g, ""))
                      }
                    />
                    <button
                      aria-label="Increase reps"
                      onClick={() => bump(setReps, reps, 1)}
                    >
                      <Plus size={18} />
                    </button>
                  </div>
                </div>
              </div>

              <div style={{ marginTop: 14 }}>
                <label className="gl-label" htmlFor="gl-d">
                  Date
                </label>
                <input
                  id="gl-d"
                  type="date"
                  className="gl-input"
                  value={date}
                  max={todayStr()}
                  onChange={(e) => setDate(e.target.value || todayStr())}
                />
              </div>

              <div className="gl-hint">
                {lastSet ? (
                  <>
                    Last {exercise} for {names[me]}:{" "}
                    <b>
                      {lastSet.weight}kg x {lastSet.reps}
                    </b>{" "}
                    on {fmtDate(lastSet.date)}
                  </>
                ) : (
                  <>No {exercise} sets logged yet for {names[me]}.</>
                )}
              </div>

              <button
                className="gl-btn"
                style={{ "--c": COLORS[me], marginTop: 16 }}
                onClick={saveSet}
                disabled={saving}
              >
                <Check size={20} />
                {saving ? "Saving..." : `Save set for ${names[me]}`}
              </button>
            </div>

            {/* today */}
            {(() => {
              const todays = logs[me].filter(
                (e) => e.date === date && e.exercise === exercise
              );
              if (!todays.length) return null;
              return (
                <div className="gl-card">
                  <span className="gl-label">
                    {exercise} on {fmtDate(date)}
                  </span>
                  {todays.map((e, i) => (
                    <div
                      key={e.id}
                      style={{
                        display: "flex",
                        justifyContent: "space-between",
                        padding: "4px 0",
                        fontSize: 15,
                      }}
                    >
                      <span style={{ color: "var(--muted)" }}>Set {i + 1}</span>
                      <b>
                        {e.weight}kg x {e.reps}
                      </b>
                    </div>
                  ))}
                </div>
              );
            })()}
          </div>
        )}

        {/* ===== PROGRESS TAB ===== */}
        {tab === "progress" && (
          <div>
            <div className="gl-stats" style={{ marginBottom: 14 }}>
              {SLOTS.map((k) => (
                <div key={k} className="gl-stat" style={{ "--c": COLORS[k] }}>
                  <h4>{names[k]}</h4>
                  <div className="gl-big gl-cond">{overall[k].sets} sets</div>
                  <div className="gl-small">
                    {overall[k].days} gym days ·{" "}
                    {overall[k].volume.toLocaleString("en-GB")}kg moved
                  </div>
                </div>
              ))}
            </div>

            <div className="gl-card">
              <div className="gl-row">
                <div>
                  <label className="gl-label" htmlFor="gl-pg">
                    Muscle group
                  </label>
                  <select
                    id="gl-pg"
                    className="gl-select"
                    value={pGroup}
                    onChange={(e) => {
                      setPGroup(e.target.value);
                      setPEx(exercisesFor(e.target.value)[0]);
                    }}
                  >
                    {GROUPS.map((g) => (
                      <option key={g}>{g}</option>
                    ))}
                  </select>
                </div>
                <div>
                  <label className="gl-label" htmlFor="gl-pe">
                    Exercise
                  </label>
                  <select
                    id="gl-pe"
                    className="gl-select"
                    value={pEx}
                    onChange={(e) => setPEx(e.target.value)}
                  >
                    {exercisesFor(pGroup).map((x) => (
                      <option key={x}>{x}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div style={{ marginTop: 14 }}>
                <div className="gl-seg" role="group" aria-label="Chart metric">
                  {METRICS.map((m) => (
                    <button
                      key={m.id}
                      aria-pressed={metric === m.id}
                      onClick={() => setMetric(m.id)}
                    >
                      {m.label}
                    </button>
                  ))}
                </div>
              </div>

              <div style={{ height: 260, marginTop: 16 }}>
                {chartData.length === 0 ? (
                  <div className="gl-empty">
                    No {pEx} sets yet. Log one on the first tab to start the
                    graph.
                  </div>
                ) : (
                  <ResponsiveContainer width="100%" height="100%">
                    <LineChart
                      data={chartData}
                      margin={{ top: 8, right: 12, left: -12, bottom: 0 }}
                    >
                      <CartesianGrid stroke="#C8CDC9" strokeDasharray="3 3" />
                      <XAxis
                        dataKey="label"
                        tick={{ fontSize: 12, fill: "#5C666F" }}
                      />
                      <YAxis
                        tick={{ fontSize: 12, fill: "#5C666F" }}
                        domain={["auto", "auto"]}
                        unit="kg"
                      />
                      <Tooltip
                        contentStyle={{
                          borderRadius: 8,
                          border: "1px solid #C8CDC9",
                          fontSize: 13,
                        }}
                        formatter={(v, key) => [`${v}kg`, names[key]]}
                      />
                      <Legend formatter={(key) => names[key]} />
                      {SLOTS.map((k) => (
                        <Line
                          key={k}
                          type="monotone"
                          dataKey={k}
                          stroke={COLORS[k]}
                          strokeWidth={3}
                          dot={{ r: 4, fill: COLORS[k] }}
                          connectNulls
                          isAnimationActive={false}
                        />
                      ))}
                    </LineChart>
                  </ResponsiveContainer>
                )}
              </div>
              <div className="gl-small" style={{ marginTop: 8 }}>
                {metric === "e1rm" &&
                  "Estimated 1RM lets you compare different weight and rep combinations (Epley formula)."}
                {metric === "top" && "Heaviest weight lifted that day."}
                {metric === "vol" && "Weight x reps added up across all sets that day."}
              </div>
            </div>

            <div className="gl-stats">
              {SLOTS.map((k) => {
                const s = statsFor(k);
                return (
                  <div key={k} className="gl-stat" style={{ "--c": COLORS[k] }}>
                    <h4>
                      {names[k]} · {pEx}
                    </h4>
                    {s ? (
                      <>
                        <div className="gl-big gl-cond">
                          {s.top.weight}kg x {s.top.reps}
                        </div>
                        <div className="gl-small">
                          Heaviest set, {fmtDate(s.top.date)}
                        </div>
                        <dl className="gl-dl">
                          <dt>Best est. 1RM</dt>
                          <dd>{s.best1}kg</dd>
                          <dt>Since first day</dt>
                          <dd
                            style={{
                              color:
                                s.change > 0
                                  ? "#15803D"
                                  : s.change < 0
                                  ? "#B91C1C"
                                  : "inherit",
                            }}
                          >
                            {s.change > 0 ? "+" : ""}
                            {s.change}kg
                          </dd>
                          <dt>Sets / days</dt>
                          <dd>
                            {s.sets} / {s.days}
                          </dd>
                        </dl>
                      </>
                    ) : (
                      <div className="gl-small">Nothing logged yet.</div>
                    )}
                  </div>
                );
              })}
            </div>
          </div>
        )}

        {/* ===== HISTORY TAB ===== */}
        {tab === "history" && (
          <div>
            <div
              style={{
                display: "flex",
                justifyContent: "space-between",
                alignItems: "center",
                gap: 8,
                flexWrap: "wrap",
              }}
            >
              <div className="gl-seg" role="group" aria-label="Filter history">
                <button
                  aria-pressed={hFilter === "all"}
                  onClick={() => setHFilter("all")}
                >
                  Both
                </button>
                {SLOTS.map((k) => (
                  <button
                    key={k}
                    aria-pressed={hFilter === k}
                    onClick={() => setHFilter(k)}
                  >
                    {names[k]}
                  </button>
                ))}
              </div>
              <button
                className="gl-btn ghost"
                onClick={() => {
                  setDraftNames({ a: names.a, b: names.b });
                  setRenaming((r) => !r);
                }}
              >
                <Pencil size={14} /> Rename lifters
              </button>
            </div>

            {renaming && (
              <div className="gl-card gl-rename" style={{ marginTop: 14 }}>
                {SLOTS.map((k) => (
                  <div key={k}>
                    <label className="gl-label" htmlFor={`gl-n-${k}`}>
                      Lifter {k === "a" ? "1" : "2"}
                    </label>
                    <input
                      id={`gl-n-${k}`}
                      className="gl-input"
                      maxLength={14}
                      value={draftNames[k]}
                      onChange={(e) =>
                        setDraftNames((d) => ({ ...d, [k]: e.target.value }))
                      }
                    />
                  </div>
                ))}
                <button
                  className="gl-btn"
                  style={{ width: "auto", padding: "10px 16px", fontSize: 15 }}
                  onClick={saveNames}
                >
                  Save
                </button>
              </div>
            )}

            {historyGroups.length === 0 ? (
              <div className="gl-empty">
                No sets logged yet. Head to Log a set to add your first one.
              </div>
            ) : (
              historyGroups.map((g) => (
                <div key={g.date}>
                  <div className="gl-day">{fmtDateLong(g.date)}</div>
                  {g.items.map((e) => (
                    <div
                      key={e.id}
                      className="gl-entry"
                      style={{ "--c": COLORS[e.slot] }}
                    >
                      <span className="gl-dot" />
                      <div className="gl-entry-main">
                        <div className="gl-entry-ex">{e.exercise}</div>
                        <div className="gl-entry-meta">
                          {names[e.slot]} · {e.group}
                        </div>
                      </div>
                      <div className="gl-entry-set gl-cond">
                        {e.weight}kg x {e.reps}
                      </div>
                      {confirmDel === e.id ? (
                        <button
                          className="gl-btn ghost"
                          style={{ color: "#B91C1C", borderColor: "#B91C1C" }}
                          onClick={() => deleteEntry(e.slot, e.id)}
                        >
                          Delete?
                        </button>
                      ) : (
                        <button
                          className="gl-icon"
                          aria-label="Delete set"
                          onClick={() => {
                            setConfirmDel(e.id);
                            setTimeout(() => setConfirmDel(null), 3000);
                          }}
                        >
                          <Trash2 size={16} />
                        </button>
                      )}
                    </div>
                  ))}
                </div>
              ))
            )}
          </div>
        )}
      </div>

      {toast && (
        <div className="gl-toast" role="status">
          <Check size={16} /> {toast}
        </div>
      )}
    </div>
  );
}
